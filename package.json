{
  "name": "devicer.js",
  "version": "3.0.0",
  "type": "module",
  "description": "Open-Source Digital Fingerprinting Middleware",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./next/sqlite": {
      "types": "./dist/next/sqlite-storage.d.ts",
      "import": "./dist/next/sqlite-storage.js",
      "default": "./dist/next/sqlite-storage.js"
    },
    "./next/postgres": {
      "types": "./dist/next/postgres-storage.d.ts",
      "import": "./dist/next/postgres-storage.js",
      "default": "./dist/next/postgres-storage.js"
    },
    "./next/redis": {
      "types": "./dist/next/redis-storage.d.ts",
      "import": "./dist/next/redis-storage.js",
      "default": "./dist/next/redis-storage.js"
    },
    "./next/node-runtime": {
      "types": "./dist/next/node-model-runtime.d.ts",
      "import": "./dist/next/node-model-runtime.js",
      "default": "./dist/next/node-model-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compat:record": "node scripts/compat-v2.mjs --record",
    "compat:check": "node scripts/compat-v2.mjs",
    "compat:package": "node scripts/compat-v2.mjs --pack",
    "compat:storage": "node scripts/compat-storage.mjs",
    "migrate:v2": "node scripts/migrate-v2.mjs",
    "next:cli": "node scripts/next-cli.mjs",
    "next:release:check": "node scripts/next-release-check.mjs",
    "test:release": "node --test tests/next-release.test.mjs",
    "test:signal-example": "tsc --noEmit --target ES2022 --module nodenext --moduleResolution nodenext --strict --esModuleInterop --skipLibCheck src/examples/physical-fingerprint.ts",
    "next:storage:check": "node scripts/next-storage-check.mjs",
    "test:next": "npx vitest run src/tests/next",
    "bridge:check": "node scripts/bridge-spike.mjs",
    "bridge:portable": "node scripts/portable-loader.mjs",
    "test": "npx vitest run",
    "test:watch": "npx vitest watch",
    "test:coverage": "npx vitest run --coverage",
    "bench": "npx vitest bench --run",
    "bench:watch": "npx vitest bench",
    "bench:ci": "npx vitest bench --run",
    "build": "tsc --outDir dist",
    "docs": "typedoc --out docs src/main.ts",
    "docs:watch": "typedoc --out docs src/main.ts --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatewaycorporate/fp-devicer.git"
  },
  "keywords": [
    "fingerprinting",
    "middleware",
    "identification",
    "tracking"
  ],
  "author": "Samuel Roux, Steven Perso, and one anonymous co-author",
  "license": "SEE LICENSE IN license.txt",
  "bugs": {
    "url": "https://github.com/gatewaycorporate/fp-devicer/issues"
  },
  "homepage": "https://github.com/gatewaycorporate/fp-devicer#readme",
  "dependencies": {
    "tlsh": "^1.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^18.15.11",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "drizzle-kit": "^0.18.1",
    "happy-dom": "^20.8.3",
    "typedoc": "^0.28.17",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "express": "^4.22.1",
    "ioredis": "^5.10.0",
    "postgres": "^3.4.8",
    "prom-client": "^14.2.0"
  },
  "allowScripts": {
    "better-sqlite3@12.6.2": true
  }
}
